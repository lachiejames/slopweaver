# Deps + build output — installed/built, never committed. `node_modules` carries no trailing slash because a
# fresh worktree's is often a SYMLINK, which `node_modules/` (a directory-only pattern) never matches. Repro:
# `ln -s ../x/node_modules node_modules && git status --short` lists it under the slashed form.
node_modules
dist/
# The built CLI (`slopweaver dev build`) — a SECOND emitter, into its own directory, because `dist/` is
# tsc's outDir and two emitters interleaving in one tree is a race with no upside.
dist-cli/
**/*.tsbuildinfo

# Coverage — the generated V8 report is never committed (vitest wipes this dir each run). The ratchet
# floor lives at the repo root in coverage-baseline.json (committed), safe from that wipe. The integration
# lane reports to its OWN directory: pointed at `coverage/`, it would overwrite the report the floor reads.
/coverage/
/coverage-integration/
# The unit lane's shard blobs, which `yarn test:unit:merge` reads and leaves in place: six of about 130 MB each
# on a local lap. Tracked-looking, a later `yarn lint` read all of them and four gates ran out of heap. Repro:
# six `yarn test:unit --shard=<i>/6 --reporter=blob` runs, then `yarn lint` with this line removed.
/.vitest-reports/

# Yarn 4 (Berry) — commit yarn.lock + .yarnrc.yml only; the version is resolved by Corepack/proto
.yarn/*
!.yarn/patches
.pnp.*

# Local world-model artifacts — a defensive net for a repo-relative $SLOPWEAVER_HOME. Anchored to the
# repo ROOT (leading `/`) so these NEVER match in-repo source dirs like `src/corpus/`. The real state
# lives under $SLOPWEAVER_HOME (outside the repo) and is never committed regardless.
/.cache/
/corpus/

# Claude Code plugin data
.claude/plugins/
# Canonical cmux-spawned worktrees for this repo — never committed, one per handover slug. The real
# directory is `.claude/worktrees.noindex/` (Spotlight skips the name; `src/worktree/location.ts`) and
# `.claude/worktrees` is the symlink to it, listed without a trailing slash because a slash never matches a symlink.
.claude/worktrees
.claude/worktrees.noindex/
# Local settings hold absolute machine paths (e.g. a memory-check hook's --dir). This is a
# public repository, so they must never be committable.
.claude/settings.local.json

.DS_Store

# local orchestration working copies (kept in a private state repo, never commit here)
STACK.md
.pr3.5-final-plan.md

# Scratch the playwright-core terminal client writes beside its working directory.
.playwright-cli/
# What the console browser lane (`yarn test:e2e`) leaves: its HTML report, and traces, video and screenshots.
/playwright-report/
/test-results/

# The local docs site build output (site/ is its own Yarn project; see docs/docs-site/runtime.md)
site/.next/
# The production console's two build slots (`scripts/docs-site.sh --serve`/`--refresh`); tsconfig names both
# so a build never rewrites it.
site/.next-serve-a/
site/.next-serve-b/
# Regenerated by `next dev`/`next build` on every run; Next's own template gitignores it.
site/next-env.d.ts
# Yarn's own resolution cache for the nested site project; regenerated by `yarn install`. Its `patches/`
# is authored, not regenerated: `site/package.json` resolves nextra through one (docs/docs-site/runtime.md).
site/.yarn/*
!site/.yarn/patches/
# The desktop shell is its own Yarn project too (desktop/README.md): `yarn build` writes `build/`,
# `yarn app` writes the packaged `.app` into `dist/`.
desktop/build/
desktop/dist/
desktop/.yarn/

# The prebuilt PreToolUse hook bundle (scripts/pretooluse.sh). Only ever written inside a versioned
# plugin install, never a checkout — this is the safety net for a root resolution that surprises us.
.hook-build/

# Proof and screenshot output never enters a pull request: it is written under $SLOPWEAVER_HOME or a
# scratchpad. TypeScript source in a src/**/proof/ module stays committable. Kept in step with
# src/proofPath/criterion.ts by the no-proof-path gate.
**/proof/**
!**/src/**/proof/**/
!**/src/**/proof/**/*.ts
!**/src/**/proof/**/*.tsx
!**/src/**/proof/**/*.[cm]ts
**/proofs/**
!**/src/**/proofs/**/
!**/src/**/proofs/**/*.ts
!**/src/**/proofs/**/*.tsx
!**/src/**/proofs/**/*.[cm]ts
**/screenshots/**
!**/src/**/screenshots/**/
!**/src/**/screenshots/**/*.ts
!**/src/**/screenshots/**/*.tsx
!**/src/**/screenshots/**/*.[cm]ts
**/.proof/**
!**/src/**/.proof/**/
!**/src/**/.proof/**/*.ts
!**/src/**/.proof/**/*.tsx
!**/src/**/.proof/**/*.[cm]ts
**/proof*.png
**/proof*.jpg
**/proof*.jpeg
**/proof*.gif
**/proof*.webp
**/proof*.mp4
**/proof*.webm
**/proof*.mov
**/proof*.tape
**/proof*.cast
**/screenshot*.png
**/screenshot*.jpg
**/screenshot*.jpeg
**/screenshot*.gif
**/screenshot*.webp
**/screenshot*.mp4
**/screenshot*.webm
**/screenshot*.mov
**/screenshot*.tape
**/screenshot*.cast
**/*.tape
**/*.cast
