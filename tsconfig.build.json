    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "tsBuildInfoFile": "./.cache/build.tsbuildinfo"
  },
  "exclude": ["dist", "node_modules"],
  "extends": "./tsconfig.json",
  "include": ["src/**/*"]
}
