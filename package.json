{
  "dependencies": {
    "@azure/msal-node": "7.1.2",
    "@datadog/datadog-api-client": "1.62.0",
    "@googleapis/admin": "37.0.2",
    "@googleapis/calendar": "20.1.0",
    "@googleapis/docs": "14.1.1",
