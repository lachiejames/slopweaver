    "@octokit/core": "7.0.8",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "@openai/codex-sdk": "0.163.0",
    "@slack/types": "3.2.0",
    "@slack/web-api": "8.2.0",
    "@supabase/storage-js": "2.118.0",
    "cloudflare": "7.3.0",
    "cron-parser": "5.10.1",
    "diff": "9.0.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.12.0",
    "fast-xml-validator": "1.4.2",
    "fathom-typescript": "0.0.43",
    "googleapis-common": "9.2.0",
    "graphql": "17.0.2",
    "jimp": "1.6.1",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "neverthrow": "8.2.0",
    "openai": "7.32.0",
    "p-limit": "7.3.3",
    "p-retry": "8.0.1",
    "p-throttle": "8.1.1",
    "p-timeout": "7.0.2",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "picomatch": "4.0.7",
    "playwright-core": "1.63.0",
    "postal-mime": "4.2.0",
    "postgres": "3.4.9",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "turbo-stream": "2.4.1",
    "typescript": "7.1.0-beta",
    "xero-node": "20.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "description": "Build a local-first, zero-key corpus from your GitHub history — ingest it, tier it, and ask questions of it, all on your machine.",
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@pollyjs/adapter-fetch": "6.0.7",
    "@pollyjs/core": "6.0.6",
    "@pollyjs/persister-fs": "6.0.6",
    "@shikijs/themes": "4.4.3",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "@yarnpkg/types": "4.0.1",
    "github-slugger": "2.0.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "nock": "14.0.17",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "promptfoo": "0.124.1",
    "react": "19.3.1",
    "scslre": "0.3.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.11"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "name": "slopweaver",
  "packageManager": "yarn@4.18.1",
  "private": true,
  "resolutions": {
    "@openai/codex-sdk": "0.163.0",
    "sharp": "portal:./stubs/sharp"
  },
  "scripts": {
    "build": "bash scripts/tsc-owner.sh --timeout-seconds 1140 --grace-seconds 5 --rss-ceiling-mib 10240 -- node_modules/.bin/tsc -p tsconfig.build.json",
    "coverage:ratchet": "tsx src/devLint/coverageRatchet.entry.ts",
    "coverage:rebaseline": "tsx src/devLint/coverageRatchet.entry.ts --rebaseline",
    "dev:gate": "tsx src/cli/index.ts dev gate",
    "devlint:agent-doc-rebaseline": "tsx src/devLint/agentDocSize.entry.ts --rebaseline",
    "devlint:clone-rebaseline": "tsx src/devLint/duplicateWindows.entry.ts --rebaseline",
    "devlint:file-size-rebaseline": "tsx src/devLint/fileSizeRatchet.entry.ts --rebaseline",
    "devlint:internal-rebaseline": "tsx src/devLint/internalExports.entry.ts --rebaseline",
    "devlint:transient-references-rebaseline": "tsx src/devLint/transientReferences.entry.ts --rebaseline",
    "devlint:untested-rebaseline": "tsx src/devLint/untestedModules.entry.ts --rebaseline",
    "docs": "bash scripts/docs-site.sh",
    "eval": "promptfoo eval -c eval/promptfooconfig.yaml",
    "eval:routing": "tsx src/cli/index.ts route evaluate --cases eval/routing.cases.json --decisions eval/routing.decisions.json --judged-by \"visible session (see eval/routing.decisions.json for who/when)\" --out eval/routing.baseline.json --json",
    "eval:turn": "promptfoo eval -c eval/promptfooconfig.turn.yaml",
    "eval:view": "promptfoo view -y",
    "format": "biome check --write . && prettier --write .",
    "hygiene": "bash scripts/check-hygiene.sh",
    "lint": "tsx src/cli/index.ts dev lint",
    "lint:local": "tsx src/cli/index.ts dev lint --lane local",
    "prepare": "lefthook install || true",
    "slopweaver": "tsx src/cli/index.ts",
    "store:push": "tsx src/cli/index.ts store push",
    "store:reset": "tsx src/cli/index.ts store reset",
    "store:start": "tsx src/cli/index.ts store start",
    "store:status": "SUPABASE_CLI_BINARY_OVERRIDE= node node_modules/supabase/dist/supabase.js status",
    "store:stop": "SUPABASE_CLI_BINARY_OVERRIDE= node node_modules/supabase/dist/supabase.js stop",
    "store:verify": "tsx src/cli/index.ts store verify",
    "test:e2e": "tsx src/testLanes/desktopE2e.entry.ts",
    "test:integration": "vitest run --config config/vitest/integration.ts",
    "test:integration:coverage": "vitest run --config config/vitest/integration.ts --coverage",
    "test:subprocess": "vitest run --config config/vitest/subprocess.ts",
    "test:subprocess:coverage": "vitest run --config config/vitest/subprocess.ts --coverage",
    "test:unit": "vitest run --config config/vitest/unit.ts --coverage",
    "test:unit:merge": "tsx src/testLanes/unitMerge.entry.ts",
    "typecheck": "bash scripts/tsc-owner.sh --timeout-seconds 1140 --grace-seconds 5 --rss-ceiling-mib 10240 -- node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "validate": "yarn lint && yarn typecheck && yarn test:unit && yarn test:subprocess && yarn coverage:ratchet",
    "validate:local": "yarn lint:local",
    "validate:pr": "yarn validate:local && yarn slopweaver codex status --check"
  },
  "type": "module",
  "version": "0.2.0"
}
