{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "typescript": ["./node_modules/typescript"],
      "typescript/ast": ["./node_modules/typescript/dist/ast/index"],
      "typescript/sync": ["./node_modules/typescript/dist/api/sync/api"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-serve-a/types/**/*.ts",
    ".next-serve-a/dev/types/**/*.ts",
    ".next-serve-b/types/**/*.ts",
    ".next-serve-b/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
